        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "RetroCam usa la cámara para mostrar el visor con filtros retro en tiempo real y hacer fotos."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "RetroCam utilise l'appareil photo pour afficher le viseur avec des filtres rétro en temps réel et prendre des photos."
