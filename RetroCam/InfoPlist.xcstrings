      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "RetroCam verwendet die Kamera, um den Sucher mit Retro-Filtern in Echtzeit anzuzeigen und Fotos aufzunehmen."
