    "Luminosità" : {

    },
    "Lumora usa la fotocamera per mostrare il mirino con i filtri in tempo reale. Puoi attivarla nelle Impostazioni." : {
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Lumora verwendet die Kamera, um den Sucher mit Filtern in Echtzeit anzuzeigen. Du kannst den Zugriff in den Einstellungen aktivieren."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Lumora uses the camera to show the viewfinder with filters in real time. You can turn it on in Settings."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Lumora usa la cámara para mostrar el visor con los filtros en tiempo real. Puedes activarla en Ajustes."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Lumora utilise l'appareil photo pour afficher le viseur avec les filtres en temps réel. Vous pouvez l'activer dans Réglages."
          }
        }
      }
    },
