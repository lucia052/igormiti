    "Live Photo non abbinabile: foto salvata senza movimento." : {
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Live Photo konnte nicht verknüpft werden: als Standbild gesichert."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Couldn't pair the Live Photo: saved as a still photo."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "No se pudo emparejar la Live Photo: se guardó como foto fija."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Impossible d'associer la Live Photo : enregistrée comme photo fixe."
          }
        }
      }
    },
